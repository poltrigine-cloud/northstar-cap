  <a href="{{ routes.root_url }}" style="font-family:var(--f-display);font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#000;background:#fff;padding:14px 36px;text-decoration:none">← Volver al inicio</a>

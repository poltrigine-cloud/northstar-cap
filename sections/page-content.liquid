<div style="max-width:800px;margin:0 auto;padding:120px 64px 80px">
  <h1 style="font-family:var(--f-display);font-size:clamp(32px,4vw,56px);font-weight:700;letter-spacing:-0.025em;margin-bottom:40px;line-height:1.05">{{ page.title }}</h1>
  <div style="font-size:15px;line-height:1.85;color:var(--muted)">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "Page Content",
  "settings": [],
  "presets": [{ "name": "Page Content" }]
}
{% endschema %}

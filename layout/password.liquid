<!doctype html>
<html lang="{{ shop.locale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Coming Soon</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700&family=Inter:wght@400&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;text-align:center;padding:48px">

  <div style="max-width:480px">
    <p style="font-size:10px;font-weight:600;letter-spacing:0.28em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-bottom:28px">Drop I · 2026 · Barcelona</p>
    <h1 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(56px,10vw,112px);font-weight:700;line-height:0.86;letter-spacing:-0.03em;margin-bottom:32px">NØRTH<br>STAR</h1>
    <p style="font-size:13px;color:rgba(255,255,255,0.42);letter-spacing:0.08em;margin-bottom:52px">Find Your North · Coming Soon</p>

    {{ content_for_layout }}
  </div>

</body>
</html>
